    <!-- Privacy -->
    <string name="feature_settings_privacy">Privacy &amp; security</string>
    <string name="feature_settings_privacy_body">Everything you enter stays on this device. SUBZERO has no account and no analytics, and connects to the internet only if you turn on enhanced answers. Your data is included in your Android backup, encrypted by Google.</string>
    <string name="feature_settings_privacy_body_ai">Enhanced answers is on: when you ask the assistant, a summary of your subscriptions (names, amounts, cycles, usage) is sent to the AI provider. Notes and your name are never sent. Turn it off any time; everything else stays on this device.</string>

