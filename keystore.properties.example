# Copy to keystore.properties (git-ignored) to sign release builds locally.
# Generate a key once and keep it safe; losing it means losing the Play listing:
#   keytool -genkeypair -v -keystore subzero-release.jks -alias subzero -keyalg RSA -keysize 4096 -validity 10000
storeFile=../subzero-release.jks
storePassword=CHANGE_ME
keyAlias=subzero
keyPassword=CHANGE_ME
