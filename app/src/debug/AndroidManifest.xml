<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Debug-only design-system gallery. Deliberately without a LAUNCHER intent-filter: a
            second home-screen icon next to the app confuses anyone with a debug build installed.
            Start it explicitly instead:
            adb shell am start -n com.subzero.app.debug/com.subzero.app.gallery.GalleryActivity
        -->
        <activity
            android:name=".gallery.GalleryActivity"
            android:exported="true"
            android:label="SUBZERO Gallery"
            android:theme="@style/Theme.Subzero" />
    </application>
</manifest>
