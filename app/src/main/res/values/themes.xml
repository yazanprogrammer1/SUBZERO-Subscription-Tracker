<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme applied after the splash screen. Compose draws everything else. -->
    <style name="Theme.Subzero" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/subzero_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash theme (androidx.core.splashscreen). -->
    <style name="Theme.Subzero.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/subzero_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Subzero</item>
    </style>
</resources>
