<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. The user's own subscription data is included in cloud and device-to-device
     backups (Google-encrypted). Nothing in the app is a secret that must be excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
